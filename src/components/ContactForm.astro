---
import Icon from "./Icon.astro";
import { profile } from "../lib/profile";
---

<form class="form" id="contact-form" novalidate>
  <div class="form__row">
    <label>Name<input name="name" autocomplete="name" required maxlength="120" /></label>
    <label>Email<input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
  </div>
  <label>Company <span class="muted">(optional)</span><input name="company" autocomplete="organization" maxlength="160" /></label>
  <label>Message<textarea name="message" rows="5" required minlength="10" maxlength="4000"></textarea></label>
  <label class="hp" aria-hidden="true">Leave this empty<input name="_honey" tabindex="-1" autocomplete="off" /></label>

  <div class="form__challenge" hidden>
    <label class="form__question">
      <span data-question>Checking that you are human…</span>
      <input
        name="answer"
        inputmode="numeric"
        autocomplete="off"
        maxlength="4"
        required
        aria-describedby="challenge-help"
      />
    </label>
    <button type="button" class="form__refresh" data-challenge-refresh>New question</button>
    <p class="form__hint" id="challenge-help">Type the answer, numbers only. It is checked on the server.</p>
  </div>

  <div class="form__foot">
    <button class="btn btn--primary" type="submit"><Icon name="mail" /> Send message</button>
    <p class="form__status" role="status" aria-live="polite"></p>
  </div>
  <p class="form__fallback" hidden>
    Or email <a href={`mailto:${profile.email}`}>{profile.email}</a>.
  </p>
  <noscript>
    <p class="form__fallback">This form needs JavaScript. Email <a href={`mailto:${profile.email}`}>{profile.email}</a> instead.</p>
  </noscript>
  <p class="form__privacy">
    Your name, email and message are kept only so I can reply — nothing else. They are held privately,
    sent to my inbox, and deleted whenever you ask: <a href={`mailto:${profile.email}`}>{profile.email}</a>.
  </p>
</form>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector(".form__status") as HTMLElement;
    const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
    const fallback = form.querySelector(".form__fallback") as HTMLElement | null;
    const box = form.querySelector(".form__challenge") as HTMLElement;
    const question = form.querySelector("[data-question]") as HTMLElement;
    const answer = form.querySelector("input[name=answer]") as HTMLInputElement;
    const refresh = form.querySelector("[data-challenge-refresh]") as HTMLButtonElement;

    const setStatus = (msg: string, kind: "ok" | "err" | "") => {
      status.textContent = msg;
      status.dataset.kind = kind;
    };
    const showFallback = (show: boolean) => {
      if (fallback) fallback.hidden = !show;
    };

    let challengeId = "";

    const loadChallenge = async () => {
      question.textContent = "Loading the question…";
      try {
        const res = await fetch("/api/challenge/", { cache: "no-store" });
        const data = (await res.json()) as { ok?: boolean; id?: string; question?: string };
        if (!res.ok || !data.ok || !data.id || !data.question) throw new Error("unavailable");
        challengeId = data.id;
        question.textContent = data.question;
        answer.value = "";
        box.hidden = false;
        answer.focus({ preventScroll: true });
      } catch {
        challengeId = "";
        box.hidden = true;
        setStatus("The verification question could not load. Reload the page, or email me directly.", "err");
        showFallback(true);
      }
    };
    loadChallenge();
    refresh.addEventListener("click", loadChallenge);

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const payload = {
        name: String(data.get("name") || "").trim(),
        email: String(data.get("email") || "").trim(),
        company: String(data.get("company") || "").trim(),
        message: String(data.get("message") || "").trim(),
        website: String(data.get("_honey") || ""),
        challenge: challengeId,
        answer: String(data.get("answer") || "").trim(),
      };

      if (payload.website) {
        setStatus("Thanks, your message was sent.", "ok");
        form.reset();
        return;
      }
      if (!payload.name) return setStatus("Please add your name.", "err");
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(payload.email)) return setStatus("Please enter a valid email address.", "err");
      if (payload.message.length < 10) return setStatus("Your message needs at least 10 characters.", "err");
      if (!payload.challenge) {
        setStatus("The verification question is missing. Reload the page, or use the email link below.", "err");
        showFallback(true);
        return;
      }
      if (!payload.answer) {
        setStatus("Answer the question to confirm you are human.", "err");
        answer.focus();
        return;
      }

      btn.disabled = true;
      showFallback(false);
      setStatus("Sending…", "");

      try {
        const controller = new AbortController();
        const timer = window.setTimeout(() => controller.abort(), 15000);
        const res = await fetch("/api/contact/", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });
        window.clearTimeout(timer);
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };

        if (res.ok && body.ok) {
          form.reset();
          setStatus("Thanks — your message is saved. I usually reply within one working day.", "ok");
          loadChallenge();
          return;
        }
        if (res.status === 429) {
          setStatus("That is a lot of messages in a short time. Try again in ten minutes, or use the email link below.", "err");
          showFallback(true);
          return;
        }
        if (body.error === "captcha") {
          setStatus("That answer did not match. Here is a new question — try again.", "err");
          loadChallenge();
          return;
        }
        setStatus("That did not go through. Send it as an email instead:", "err");
        showFallback(true);
      } catch (err) {
        if (err instanceof DOMException && err.name === "AbortError") {
          setStatus("The server did not answer in time. Use the email link below — nothing was sent.", "err");
          showFallback(true);
        } else {
          setStatus("That did not go through. Send it as an email instead:", "err");
          showFallback(true);
        }
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>

<style>
  .form {
    display: grid;
    gap: var(--space-4);
    background: var(--color-ink-2, #111f34);
    border: 1px solid var(--color-ink-border, #22334c);
    border-radius: var(--radius-lg, 18px);
    padding: clamp(var(--space-5, 1.25rem), 3vw, var(--space-8, 2rem));
  }
  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4, 1rem); }
  .form label { display: grid; gap: var(--space-2, 0.5rem); font-size: var(--text-sm, 0.95rem); font-weight: 500; color: var(--color-ink-text, #e6ebf2); }
  .form label > span { font-weight: 400; }
  .form input,
  .form textarea {
    width: 100%;
    padding: var(--space-3, 0.75rem);
    border-radius: var(--radius-md, 12px);
    border: 1px solid var(--color-ink-border, #22334c);
    background: var(--color-ink, #0b1626);
    color: var(--color-ink-text, #e6ebf2);
    min-height: 44px;
    font: inherit;
  }
  .form textarea { resize: vertical; }
  .form input:focus,
  .form textarea:focus {
    outline: none;
    border-color: var(--color-ink-accent, #8fb4ff);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-ink-accent, #8fb4ff) 25%, transparent);
  }
  .form__challenge {
    display: grid;
    gap: 8px;
    padding: 14px 16px;
    border: 1px dashed var(--color-ink-border, #22334c);
    border-radius: var(--radius-md, 12px);
    background: rgba(255, 255, 255, 0.03);
  }
  .form__challenge[hidden] { display: none; }
  .form__question { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
  .form__question > span { font-size: 15px; color: var(--color-ink-text, #e6ebf2); }
  .form__question input { width: 110px; min-height: 40px; text-align: center; }
  .form__refresh {
    justify-self: start;
    font: inherit;
    font-size: 12.5px;
    color: var(--color-ink-accent, #8fb4ff);
    background: none;
    border: 0;
    padding: 0;
    text-decoration: underline;
    cursor: pointer;
  }
  .form__hint { margin: 0; font-size: 12px; color: var(--color-ink-muted, #9aa8bb); }
  .form__foot { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4, 1rem); }
  .form__foot .btn--primary { background: var(--color-ink-accent, #8fb4ff); color: var(--color-ink, #0b1626); }
  .form__foot .btn--primary:hover { background: #b5ceff; }
  .form__foot .btn--primary:disabled { opacity: 0.6; cursor: progress; }
  .form__status { font-size: var(--text-sm, 0.95rem); margin: 0; }
  .form__status[data-kind="ok"] { color: var(--color-ink-accent, #8fb4ff); }
  .form__status[data-kind="err"] { color: #ffb4a8; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .form__fallback { margin: 0; font-size: 13.5px; color: var(--color-ink-muted, #9aa8bb); }
  .form__fallback a { color: var(--color-ink-accent, #8fb4ff); text-decoration: underline; }
  .form__fallback[hidden] { display: none; }
  .form__privacy { margin: 0; font-size: 12.5px; line-height: 1.5; color: var(--color-ink-muted, #9aa8bb); }
  .form__privacy a { color: var(--color-ink-accent, #8fb4ff); }
  .muted { font-weight: 400; color: var(--color-ink-muted, #9aa8bb); }
  @media (max-width: 700px) {
    .form__row { grid-template-columns: 1fr; }
  }
</style>
