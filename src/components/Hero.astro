---
import Icon from "./Icon.astro";
import Snapshot from "./Snapshot.astro";
import { profile, stats, credentials } from "../lib/profile";

interface Props {
  title: string;
  lead: string;
  /** Short line in the green status pill, e.g. "Open to IT support roles". */
  status?: string;
  /** PDF offered by the primary button. */
  resume?: string;
  /** Third, text-style call to action. */
  cta?: { href: string; label: string };
}
const {
  title,
  lead,
  status = "Open to IT support roles",
  resume = profile.resumePdf,
  cta = { href: "#work", label: "View projects" },
} = Astro.props;
const certs = credentials.filter((c) => c.kind === "cert");
---
<section class="hero">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="hero__status"><span class="dot" aria-hidden="true"></span>{status}<span class="hero__loc"> · {profile.location}</span></p>
      <h1>{title}</h1>
      <p class="hero__lead">{lead}</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href={resume} download><Icon name="download" /> Download resume</a>
        <a class="btn btn--ghost" href={profile.linkedin} target="_blank" rel="me noopener"><Icon name="linkedin" /> LinkedIn profile</a>
        <a class="btn btn--text" href={cta.href}>{cta.label} <Icon name="arrow" /></a>
      </div>
      <div class="verified">
        <p class="verified__label"><Icon name="shield" /> Verified credentials</p>
        <ul class="verified__list" role="list">
          {certs.map((c) => (
            <li><a href={c.verify} target="_blank" rel="noopener" title={`Verify ${c.name} on ${c.verifyLabel}`}><img src={c.badge} alt={`${c.name} badge`} width="64" height="64" loading="eager" /></a></li>
          ))}
        </ul>
      </div>
    </div>
    <Snapshot />
  </div>
  <div class="wrap">
    <ul class="stats" role="list">
      {stats.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span></li>)}
    </ul>
  </div>
</section>
<style>
  .hero {
    padding-block: clamp(var(--space-12), 8vw, var(--space-20)) clamp(var(--space-12), 6vw, var(--space-16));
    color: var(--color-ink-text);
    background:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px) 0 0 / 48px 48px,
      radial-gradient(1100px 520px at 88% -10%, color-mix(in oklab, var(--color-primary) 60%, transparent), transparent 70%),
      radial-gradient(800px 480px at -5% 105%, color-mix(in oklab, var(--color-accent) 45%, transparent), transparent 70%),
      linear-gradient(165deg, var(--color-ink) 0%, var(--color-ink-2) 55%, var(--color-primary-active) 130%);
  }
  .hero :global(:focus-visible) { outline-color: var(--color-ink-accent); }
  .hero__grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(var(--space-8), 5vw, var(--space-16)); align-items: center; }
  .hero__copy { display: grid; gap: var(--space-6); }
  .hero__status { display: inline-flex; align-items: center; gap: var(--space-2); width: fit-content; font-size: var(--text-sm); font-weight: 600; color: var(--color-success); background: var(--color-success-highlight); padding: var(--space-1) var(--space-4); border-radius: var(--radius-full); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 3px color-mix(in oklab, currentColor 25%, transparent); }
  h1 { font-family: var(--font-display); font-weight: 600; font-size: var(--text-2xl); letter-spacing: -0.03em; line-height: 1.06; max-width: 17ch; }
  .hero__lead { color: var(--color-ink-muted); font-size: var(--text-base); max-width: 58ch; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; }
  .btn--text { color: var(--color-ink-accent); padding-inline: var(--space-3); }
  .btn--text:hover { color: var(--color-ink-text); }
  .hero__cta .btn--ghost { background: rgb(255 255 255 / 0.06); border-color: var(--color-ink-border); color: var(--color-ink-text); }
  .hero__cta .btn--ghost:hover { background: rgb(255 255 255 / 0.12); border-color: var(--color-ink-muted); }
  .verified { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); padding-top: var(--space-5); border-top: 1px solid var(--color-ink-border); }
  .verified__label { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-ink-muted); }
  .verified__label :global(svg) { width: 1.2em; height: 1.2em; color: var(--color-success-highlight); }
  .verified__list { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .verified__list a { display: block; border-radius: 50%; transition: transform var(--transition-interactive); }
  .verified__list a:hover { transform: translateY(-2px); }
  .verified__list img { width: 56px; height: 56px; border-radius: var(--radius-md); background: #fff; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: clamp(var(--space-10), 6vw, var(--space-16)); background: rgb(255 255 255 / 0.05); border: 1px solid var(--color-ink-border); border-radius: var(--radius-lg); backdrop-filter: blur(6px); }
  .stats li { display: grid; gap: var(--space-2); padding: var(--space-6); }
  .stats li + li { border-left: 1px solid var(--color-ink-border); }
  .stats strong { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; color: var(--color-ink-accent); line-height: 1; }
  .stats span { font-size: var(--text-sm); color: var(--color-ink-muted); }

  @media (max-width: 900px) {
    .hero__grid { grid-template-columns: 1fr; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stats li:nth-child(3) { border-left: 0; }
    .stats li:nth-child(n+3) { border-top: 1px solid var(--color-ink-border); }
  }
  @media (max-width: 560px) {
    .hero__loc { display: none; }
    .stats li { padding: var(--space-4); }
  }
</style>
