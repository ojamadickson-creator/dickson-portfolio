---
import { getCollection } from "astro:content";
import { recentlyShipped, daysAgo } from "../lib/github";

interface Props {
  /** Only show labs from these tracks. Omit for all. */
  tracks?: ("it" | "security")[];
}
const { tracks } = Astro.props;
const all = await getCollection("projects");
const items = (await recentlyShipped(all)).filter((s) => !tracks || tracks.includes(s.track as "it" | "security"));
---
{items.length > 0 && (
  <div class="shipped">
    <p class="shipped__label">Recently shipped</p>
    <ul role="list">
      {items.map((s) => (
        <li>
          <a href={s.commit.url} title={s.commit.message}>
            <span class="mono">{s.code}</span> · last commit <time datetime={s.commit.date}>{daysAgo(s.commit.date)}</time>
          </a>
        </li>
      ))}
    </ul>
  </div>
)}
<style>
  .shipped { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-5); margin-top: var(--space-8); padding-top: var(--space-4); border-top: 1px dashed var(--color-divider); font-size: var(--text-sm); }
  .shipped__label { font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); }
  ul { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  a { color: var(--color-text-muted); text-decoration: none; }
  a:hover { color: var(--color-primary); }
  .mono { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-primary); }
</style>
