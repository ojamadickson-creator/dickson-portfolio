---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
interface Props { project: CollectionEntry<"projects"> }
const { project } = Astro.props;
const d = project.data;
---
<article class="ticket">
  <a class="ticket__media" href={`/projects/${project.id}/`} tabindex="-1" aria-hidden="true">
    <img src={d.evidence.src} alt="" width="800" height="500" loading="lazy" decoding="async" />
  </a>
  <div class="ticket__body">
    <div class="ticket__meta">
      <span class="ticket__code">{d.code}</span>
      <span class="ticket__tag">Case study</span>
    </div>
    <h3><a href={`/projects/${project.id}/`}>{d.title}</a></h3>
    <p>{d.summary}</p>
    <ul class="ticket__stack" role="list">
      {d.stack.slice(0, 4).map((s) => <li>{s}</li>)}
      {d.stack.length > 4 && <li>+{d.stack.length - 4}</li>}
    </ul>
    <div class="ticket__links">
      <a class="link" href={`/projects/${project.id}/`}>Read the case study</a>
      {d.video && <a class="ticket__video" href={d.video}><Icon name="play" /> Video</a>}
    </div>
  </div>
</article>
<style>
  .ticket { display: grid; grid-template-rows: auto 1fr; background: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; transition: border-color var(--transition-interactive), box-shadow var(--transition-interactive); }
  .ticket:hover { border-color: var(--color-text-faint); box-shadow: var(--shadow-md); }
  .ticket__media { display: block; aspect-ratio: 16 / 10; background: var(--color-surface-offset); border-bottom: 1px solid var(--color-divider); overflow: hidden; }
  .ticket__media img { width: 100%; height: 100%; object-fit: cover; object-position: top left; }
  .ticket__body { display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-5); }
  .ticket__meta { display: flex; justify-content: space-between; align-items: center; gap: var(--space-2); }
  .ticket__code { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-muted); }
  h3 { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; letter-spacing: -0.015em; line-height: 1.25; }
  .ticket__tag { font-size: 0.75rem; font-weight: 600; color: var(--color-primary); background: var(--color-primary-highlight); padding: 2px var(--space-3); border-radius: var(--radius-full); }
  h3 a { text-decoration: none; }
  h3 a:hover { color: var(--color-primary); }
  p { color: var(--color-text-muted); font-size: var(--text-sm); }
  .ticket__stack { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: auto; padding-top: var(--space-2); }
  .ticket__stack li { font-size: 0.75rem; padding: 2px var(--space-2); border: 1px solid var(--color-divider); border-radius: var(--radius-sm); color: var(--color-text-muted); }
  .ticket__links { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); font-size: var(--text-sm); font-weight: 600; padding-top: var(--space-2); border-top: 1px dashed var(--color-divider); }
  .ticket__video { display: inline-flex; align-items: center; gap: var(--space-1); text-decoration: none; color: var(--color-text-muted); }
  .ticket__video:hover { color: var(--color-text); }
  .ticket__video :global(svg) { width: 1.1em; height: 1.1em; }
</style>
