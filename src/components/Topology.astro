---
// Interactive version of public/evidence/home-lab.svg. Every fact below comes from that diagram
// or from the LAB-01 and LAB-03 case studies. Edit the nodes prop, not the markup.
export interface TopologyNode {
  id: string;
  label: string;
  sub: string;
  detail: string;
  x: number;
  y: number;
  zone: "onprem" | "cloud";
  href?: string;
}
interface Props {
  nodes?: TopologyNode[];
}

const defaults: TopologyNode[] = [
  { id: "dc01", label: "DC01", sub: "192.168.10.10", zone: "onprem", x: 40, y: 80, href: "/projects/active-directory/",
    detail: "Windows Server 2025. AD DS, DNS, Global Catalog and the FSMO roles for ad.beginningdimension.com. It syncs time from external NTP, which fixed the Kerberos clock skew that broke Group Policy on CLIENT01." },
  { id: "dc02", label: "DC02", sub: "192.168.10.11", zone: "onprem", x: 245, y: 80, href: "/projects/active-directory/",
    detail: "Windows Server 2025. Replica domain controller and Global Catalog, so sign-in and DNS keep working if DC01 is down." },
  { id: "client01", label: "CLIENT01", sub: "192.168.10.20", zone: "onprem", x: 40, y: 210, href: "/projects/intune-hybrid/",
    detail: "Windows 11 Pro pilot device with TPM 2.0 and UEFI. Domain-joined in the Workstations OU, hybrid joined to Entra ID and enrolled in Intune automatically. Windows LAPS rotates its local admin password." },
  { id: "syncsrv01", label: "SYNCSRV01", sub: "Entra Connect · PHS", zone: "onprem", x: 245, y: 210, href: "/projects/intune-hybrid/",
    detail: "Runs Entra Connect with password hash sync and OU filtering. Tier 0 and Tier 1 admin OUs and service accounts are filtered out, so privileged on-premises accounts never sync to the cloud." },
  { id: "entra", label: "Entra ID", sub: "P1", zone: "cloud", x: 495, y: 80, href: "/projects/entra-id-governance/",
    detail: "Microsoft Entra ID P1 in a Business Premium tenant. Holds the identities synced by password hash sync, the hybrid-joined device objects and the BitLocker recovery keys." },
  { id: "ca", label: "Conditional Access", sub: "MFA + compliant device", zone: "cloud", x: 705, y: 80, href: "/projects/intune-hybrid/",
    detail: "Two policies: CA-MFA-AllUsers and CA-RequireCompliantDevice. Both ran in report-only mode first, with break-glass accounts excluded, then I switched them on." },
  { id: "intune", label: "Intune", sub: "Plan 1", zone: "cloud", x: 495, y: 210, href: "/projects/intune-hybrid/",
    detail: "Compliance policies for BitLocker, Secure Boot, Defender health and patch level, plus an MDM security baseline, configuration profiles, Win32 apps and updates." },
  { id: "m365", label: "Microsoft 365", sub: "Exchange · SharePoint · Apps", zone: "cloud", x: 705, y: 210, href: "/projects/sharepoint-teams/",
    detail: "Exchange Online, SharePoint and Microsoft 365 Apps. Conditional Access only lets compliant devices in." },
];
const { nodes = defaults } = Astro.props;
const W = 190;
const H = 56;
// Connectors are drawn for the default layout. If you move nodes, move these too.
const links = [
  { d: "M230 108 H245", label: "" },
  { d: "M135 136 V210", label: "domain join · GPO", x: 143, y: 177 },
  { d: "M200 136 L310 210", label: "directory read", x: 282, y: 166 },
  { d: "M435 238 L495 108", label: "" },
  { d: "M685 108 H705", label: "" },
  { d: "M590 136 V210", label: "hybrid join · MDM", x: 598, y: 177 },
  { d: "M800 136 V210", label: "grant / block", x: 808, y: 177 },
  { d: "M135 266 V292 H590 V266", label: "Intune manages CLIENT01: compliance · apps · updates", x: 250, y: 304, dashed: true },
];
const panelId = "topology-panel";
---
<figure class="topo" data-topology>
  <div class="topo__scroll">
    <svg viewBox="0 0 925 320" role="group" aria-labelledby="topo-title" class="topo__svg">
      <title id="topo-title">Lab topology: on-premises Active Directory, Entra Connect, Entra ID, Intune and Microsoft 365</title>
      <rect class="topo__zone" x="20" y="20" width="425" height="290" rx="12" />
      <text class="topo__zone-label" x="40" y="52">On-premises · ad.beginningdimension.com</text>
      <rect class="topo__zone topo__zone--cloud" x="475" y="20" width="430" height="290" rx="12" />
      <text class="topo__zone-label" x="495" y="52">Microsoft 365 tenant · Business Premium</text>
      {links.map((l) => (
        <g class="topo__link" aria-hidden="true">
          <path d={l.d} class={l.dashed ? "topo__link--mgmt" : undefined} />
          {l.label && <text x={l.x} y={l.y}>{l.label}</text>}
        </g>
      ))}
      {nodes.map((n) => (
        <g class={`topo__node topo__node--${n.zone}`} data-node={n.id} tabindex="0" role="button" aria-controls={panelId} aria-pressed="false" transform={`translate(${n.x} ${n.y})`}>
          <title>{`${n.label}: ${n.sub}`}</title>
          <rect width={W} height={H} rx="8" />
          <text class="topo__label" x="12" y="24">{n.label}</text>
          <text class="topo__sub" x="12" y="43">{n.sub}</text>
        </g>
      ))}
    </svg>
  </div>
  <div class="topo__panel" id={panelId} aria-live="polite">
    <p class="topo__panel-title" data-panel-title>Select a machine or service</p>
    <p data-panel-detail>Click a box, or Tab to it and press Enter, to see what it does in the lab.</p>
    <a class="link" href="/projects/intune-hybrid/" data-panel-link hidden>Read the case study</a>
  </div>
  <figcaption class="topo__facts">
    <p class="topo__facts-title">Every node, in plain text</p>
    <dl>
      {nodes.map((n) => (
        <div><dt>{n.label} <span>· {n.sub}</span></dt><dd>{n.detail}</dd></div>
      ))}
    </dl>
  </figcaption>
  <script type="application/json" data-topology-nodes set:html={JSON.stringify(nodes.map(({ id, label, sub, detail, href }) => ({ id, label, sub, detail, href })))} />
</figure>

<style>
  .topo { display: grid; gap: var(--space-4); }
  .topo__scroll { overflow-x: auto; background: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: var(--radius-lg); }
  .topo__svg { display: block; width: 100%; min-width: 660px; height: auto; aspect-ratio: 925 / 320; font-family: var(--font-body); }
  .topo__zone { fill: var(--color-surface); stroke: var(--color-divider); stroke-dasharray: 4 4; }
  .topo__zone--cloud { fill: var(--color-primary-highlight); stroke: var(--color-border); }
  .topo__zone-label { font-size: 12px; font-weight: 700; letter-spacing: 0.04em; fill: var(--color-text-muted); }
  .topo__link path { stroke: var(--color-text-faint); stroke-width: 1.5; fill: none; }
  .topo__link .topo__link--mgmt { stroke-dasharray: 5 4; }
  .topo__link text { font-size: 10px; fill: var(--color-text-muted); }
  .topo__node { cursor: pointer; outline: none; }
  .topo__node rect { fill: var(--color-surface-2); stroke: var(--color-border); stroke-width: 1.5; transition: stroke var(--transition-interactive), fill var(--transition-interactive); }
  .topo__node--onprem rect { fill: #fff; }
  .topo__label { font-family: var(--font-display); font-size: 15px; font-weight: 600; fill: var(--color-text); }
  .topo__sub { font-family: var(--font-mono); font-size: 10px; fill: var(--color-text-muted); }
  .topo__node:hover rect { stroke: var(--color-primary); }
  .topo__node:focus-visible rect { stroke: var(--color-primary); stroke-width: 3; }
  .topo__node[aria-pressed="true"] rect { fill: var(--color-primary-highlight); stroke: var(--color-primary); stroke-width: 2.5; }
  .topo__node[aria-pressed="true"] .topo__label { fill: var(--color-primary); }
  .topo__panel { display: grid; gap: var(--space-2); min-height: 7.5rem; padding: var(--space-4) var(--space-5); border-left: 2px solid var(--color-primary); background: var(--color-surface-2); border-radius: 0 var(--radius-md) var(--radius-md) 0; font-size: var(--text-sm); }
  .topo__panel-title { font-weight: 700; font-size: var(--text-base); }
  .topo__panel p:not(.topo__panel-title) { color: var(--color-text-muted); max-width: 68ch; }
  .topo__panel .link { width: fit-content; font-weight: 600; }
  .topo__facts { font-size: var(--text-sm); }
  .topo__facts-title { font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); margin-bottom: var(--space-3); }
  .topo__facts dl { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3) var(--space-6); }
  .topo__facts dt { font-weight: 700; }
  .topo__facts dt span { font-weight: 400; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-muted); }
  .topo__facts dd { color: var(--color-text-muted); }
  @media (max-width: 720px) { .topo__facts dl { grid-template-columns: 1fr; } }
  @media print { .topo__panel { display: none; } }
</style>

<script>
  type Node = { id: string; label: string; sub: string; detail: string; href?: string };
  document.querySelectorAll<HTMLElement>("[data-topology]").forEach((root) => {
    const data = root.querySelector("[data-topology-nodes]");
    const nodes: Node[] = data ? JSON.parse(data.textContent || "[]") : [];
    const title = root.querySelector<HTMLElement>("[data-panel-title]");
    const detail = root.querySelector<HTMLElement>("[data-panel-detail]");
    const link = root.querySelector<HTMLAnchorElement>("[data-panel-link]");
    const groups = [...root.querySelectorAll<SVGGElement>("[data-node]")];

    const select = (g: SVGGElement) => {
      const n = nodes.find((x) => x.id === g.dataset.node);
      if (!n || !title || !detail) return;
      groups.forEach((x) => x.setAttribute("aria-pressed", String(x === g)));
      title.textContent = `${n.label} · ${n.sub}`;
      detail.textContent = n.detail;
      if (link) {
        link.hidden = !n.href;
        if (n.href) link.href = n.href;
      }
    };

    groups.forEach((g) => {
      g.addEventListener("click", () => select(g));
      g.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          select(g);
        }
      });
    });
  });
</script>
