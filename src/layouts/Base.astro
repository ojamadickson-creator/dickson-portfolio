---
import "../styles/global.css";
import { profile } from "../lib/profile";
import Icon from "../components/Icon.astro";
import SecurityWatermark from "../components/SecurityWatermark.astro";
import IntroSplash from "../components/IntroSplash.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { getCollection } from "astro:content";

interface Props {
  title: string;
  description: string;
  path?: string;
  dark?: boolean;
}
const { title, description, path = "/", dark = false, intro = false } = Astro.props;
const site = Astro.site ?? new URL("https://example.vercel.app");
/** Serialise JSON for an inline <script>: escape "<" so content can never close the tag early. */
const jsonForScript = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");
const canonical = new URL(path, site).toString();
const ogImage = new URL("/og.png", site).toString();
const current = Astro.url.pathname;
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const paletteItems = [
  { group: "Jump to", label: "Projects", hint: "section", href: "/#work" },
  { group: "Jump to", label: "Security labs", hint: "about", href: "/about/#security" },
  { group: "Jump to", label: "Certifications", hint: "section", href: "/#certs" },
  { group: "Jump to", label: "Experience", hint: "about", href: "/about/#experience" },
  { group: "Jump to", label: "Resume", hint: "page", href: "/resume/" },
  { group: "Jump to", label: "Contact", hint: "section", href: "/#contact" },
  ...projects.map((p) => ({
    group: p.data.track === "security" ? "Security labs" : "IT support projects",
    label: p.data.title,
    hint: p.data.code,
    href: `/projects/${p.id}/`,
  })),
];
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  knowsAbout: ["Windows", "macOS", "Microsoft 365", "Microsoft Entra ID", "Microsoft Intune", "Active Directory", "TCP/IP networking"],
  email: `mailto:${profile.email}`,
  address: { "@type": "PostalAddress", addressLocality: "Almada", addressCountry: "PT" },
  sameAs: [profile.linkedin, profile.github],
  url: site.toString(),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f5f6f8" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600&f[]=satoshi@400,500,700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={jsonForScript(personLd)} />
  </head>
  <body class={dark ? "theme-dark" : undefined}>
    <SecurityWatermark />
    {intro && <IntroSplash />}
    <a class="sr-only" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${profile.name}, home`}>
          <span class="brand__mark" aria-hidden="true">DO</span>
          <span class="brand__text"><span class="brand__name">{profile.name}</span><span class="brand__role">{profile.role}</span></span>
        </a>
        <nav class="nav" aria-label="Main">
          <a class="nav__link" href="/#what">What I do</a>
          <a class="nav__link" href="/#work">Work</a>
          <a class="nav__link" href="/#certs">Certifications</a>
          <a class="nav__link" href="/about/">About</a>
          <a href="/resume/" aria-current={current.startsWith("/resume") ? "page" : undefined}>Resume</a>
          <button class="nav__search" type="button" data-palette-open aria-label="Search this site">
            <Icon name="search" />
            <kbd>⌘K</kbd>
          </button>
          <span class="nav__sep" aria-hidden="true"></span>
          <a class="icon-link" href={profile.github} aria-label="GitHub profile" rel="me noopener" target="_blank"><Icon name="github" /></a>
          <a class="icon-link" href={profile.linkedin} aria-label="LinkedIn profile" rel="me noopener" target="_blank"><Icon name="linkedin" /></a>
          <a class="nav__cta" href="/#contact">Contact me</a>
        </nav>
        <details class="menu">
          <summary aria-label="Open menu"><Icon name="menu" /></summary>
          <div class="menu__panel">
            <a href="/#work">Projects</a>
            <a href="/#security">Security</a>
            <a href="/#certifications">Certifications</a>
            <a href="/#experience">Experience</a>
            <a href="/resume/">Resume</a>
            <a href={profile.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
            <a href={profile.github} target="_blank" rel="me noopener">GitHub</a>
            <a href="/#contact">Contact me</a>
          </div>
        </details>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="site-footer__top">
          <div><strong>{profile.name}</strong>{profile.role} · {profile.location}</div>
          <nav aria-label="Footer">
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
            <a href={profile.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
            <a href={profile.github} target="_blank" rel="me noopener">GitHub</a>
            <a href={profile.resumePdf} download>Resume (PDF)</a>
          </nav>
        </div>
        <p>© {new Date().getFullYear()} {profile.name}. Credentials can be verified via the links on this site.</p>
      </div>
    </footer>
    <dialog class="palette" data-palette aria-label="Search this site">
      <div class="palette__field">
        <Icon name="search" />
        <input type="search" placeholder="Jump to a project, section or page…" autocomplete="off" aria-label="Search" data-palette-input />
        <kbd>esc</kbd>
      </div>
      <ul class="palette__list" role="listbox" aria-label="Results" data-palette-list></ul>
      <p class="palette__hint"><kbd>↑</kbd><kbd>↓</kbd> to move <kbd>↵</kbd> to open</p>
    </dialog>
    <script type="application/json" id="palette-data" set:html={jsonForScript(paletteItems)}></script>
    <script>
      const dialog = document.querySelector<HTMLDialogElement>("[data-palette]");
      const input = document.querySelector<HTMLInputElement>("[data-palette-input]");
      const list = document.querySelector<HTMLUListElement>("[data-palette-list]");
      const dataEl = document.getElementById("palette-data");
      type Item = { group: string; label: string; hint: string; href: string };
      const items: Item[] = dataEl ? JSON.parse(dataEl.textContent || "[]") : [];
      let active = 0;
      let shown: Item[] = [];

      const render = () => {
        const q = (input?.value || "").trim().toLowerCase();
        shown = q
          ? items.filter((it) => (it.label + " " + it.hint + " " + it.group).toLowerCase().includes(q))
          : items;
        if (!list) return;
        active = Math.min(active, Math.max(0, shown.length - 1));
        list.innerHTML = shown
          .map((it, i) => {
            const on = i === active;
            return '<li role="option" aria-selected="' + on + '" data-i="' + i + '"' + (on ? ' data-active="1"' : "") +
              '><a href="' + it.href + '"><span>' + it.label + '</span><em>' + (it.hint || it.group) + '</em></a></li>';
          })
          .join("");
      };

      const openPalette = () => {
        if (!dialog) return;
        dialog.showModal();
        render();
        input?.focus();
        input?.select();
      };
      const go = (i: number) => {
        const target = shown[i];
        if (target) { dialog?.close(); const url = new URL(target.href, location.origin); if (url.pathname === location.pathname && url.hash) { const el = document.querySelector(url.hash); if (el) { el.scrollIntoView({ behavior: "smooth", block: "start" }); history.replaceState(null, "", url.hash); return; } } location.assign(url.href); }
      };

      document.querySelectorAll("[data-palette-open]").forEach((b) => b.addEventListener("click", openPalette));
      document.addEventListener("keydown", (e) => {
        const k = e.key.toLowerCase();
        if ((e.metaKey || e.ctrlKey) && k === "k") {
          e.preventDefault();
          if (dialog?.open) { dialog.close(); } else { openPalette(); }
          return;
        }
        if (!dialog?.open) return;
        if (k === "escape") { dialog.close(); return; }
        if (k === "arrowdown" || k === "arrowup") {
          e.preventDefault();
          if (!shown.length) return;
          active = k === "arrowdown" ? (active + 1) % shown.length : (active - 1 + shown.length) % shown.length;
          render();
          return;
        }
        if (k === "enter") {
          e.preventDefault();
          go(active);
        }
      });
      input?.addEventListener("input", render);
      list?.addEventListener("click", (e) => {
        const li = (e.target as HTMLElement).closest("[data-i]");
        if (li) { e.preventDefault(); go(Number(li.getAttribute("data-i"))); }
      });
      dialog?.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });
    </script>
    <script>
      document.querySelectorAll<HTMLAnchorElement>(".menu__panel a").forEach((a) => a.addEventListener("click", () => a.closest("details")?.removeAttribute("open")));
    </script>
    <SpeedInsights />
  </body>
</html>
