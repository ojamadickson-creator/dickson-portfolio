---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found · Dickson Ojama" description="This page doesn't exist." path="/404">
  <div class="wrap--narrow nf">
    <p class="eyebrow">Error 404</p>
    <h1>This ticket doesn't exist.</h1>
    <p>The page may have moved. Head back to the homepage to see my work.</p>
    <a class="btn btn--primary" href="/">Back to the homepage</a>
  </div>
</Base>
<style>
  .nf { padding-block: var(--space-24); display: grid; gap: var(--space-5); justify-items: start; }
  h1 { font-family: var(--font-display); font-weight: 800; font-size: var(--text-2xl); }
  p:not(.eyebrow) { color: var(--color-text-muted); }
</style>
