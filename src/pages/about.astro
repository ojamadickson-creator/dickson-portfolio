---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import TicketCard from "../components/TicketCard.astro";
import Icon from "../components/Icon.astro";
import ContactForm from "../components/ContactForm.astro";
import { profile, stats, experience, credentials, inProgress, skills, tools } from "../lib/profile";
import { getRepos, HIDDEN_REPOS } from "../lib/github";

const all = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const itProjects = all.filter((p) => p.data.track === "it");
const secProjects = all.filter((p) => p.data.track === "security");
const repos = (await getRepos()).slice(0, 6);
const certs = credentials.filter((c) => c.kind === "cert");
const training = credentials.filter((c) => c.kind === "training");
const initials = (s: string) => s.replace(/[^A-Za-z ]/g, "").split(" ").filter(Boolean).slice(0, 2).map((w) => w[0]).join("").toUpperCase();
const fmt = (iso: string) => new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? "https://mxszpcxuucrmgoqsobpf.supabase.co";
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? "sb_publishable_PWZ56gXJZkvteEYxwKJsDQ_PeCDGZMc";
---
<Base
  title={`About · ${profile.name} · IT Support Technician (L1/L2) · Lisbon`}
  description="IT support technician in Lisbon with CompTIA A+, Network+ and Security+. Hands-on labs in Active Directory, Entra ID, Intune and Microsoft 365, plus security detection labs."
>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="hero__status"><span class="dot" aria-hidden="true"></span>Open to IT support roles<span class="hero__loc"> · {profile.location}</span></p>
        <h1>IT support that gets people back to work, and keeps them there.</h1>
        <p class="hero__lead">IT Support Technician (L1/L2) with three years of technical support, CompTIA A+, Network+ and Security+ certified. I resolve desktop, account-access and connectivity issues, then document the fix so it stays fixed. My home lab runs a hybrid Active Directory, Entra ID and Intune environment.</p>
        <div class="hero__cta">
          <a class="btn btn--primary" href={profile.resumePdf} download><Icon name="download" /> Download resume</a>
          <a class="btn btn--ghost" href={profile.linkedin} target="_blank" rel="me noopener"><Icon name="linkedin" /> LinkedIn profile</a>
          <a class="btn btn--text" href="#work">View projects <Icon name="arrow" /></a>
        </div>
        <div class="verified">
          <p class="verified__label"><Icon name="shield" /> Verified credentials</p>
          <ul class="verified__list" role="list">
            {certs.map((c) => (
              <li><a href={c.verify} target="_blank" rel="noopener" title={`Verify ${c.name} on ${c.verifyLabel}`}><img src={c.badge} alt={`${c.name} badge`} width="64" height="64" loading="eager" /></a></li>
            ))}
          </ul>
        </div>
      </div>
      <aside class="snapshot" aria-label="Candidate summary">
        <div class="snapshot__head">
          <span>Candidate snapshot</span>
          <span class="pill">Available now</span>
        </div>
        <dl>
          <div><dt>Role</dt><dd>{profile.role}, {profile.focus}</dd></div>
          <div><dt>Looking for</dt><dd>{profile.lookingFor.join(" · ")}</dd></div>
          <div><dt>Certified</dt><dd>CompTIA Security+, Network+, A+, CSIS, CIOS <span class="muted">· MD-102 in progress</span></dd></div>
          <div><dt>Languages</dt><dd>{profile.languages}</dd></div>
          <div><dt>Work permit</dt><dd>{profile.workAuth}</dd></div>
        </dl>
        <a class="snapshot__foot" href={`mailto:${profile.email}`}><Icon name="mail" /> {profile.email}</a>
      </aside>
    </div>
    <div class="wrap">
      <ul class="stats" role="list">
        {stats.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- Home lab -->
  <section class="section section--ink" id="lab">
    <div class="wrap lab">
      <div class="section-head">
        <p class="eyebrow">The environment behind the case studies</p>
        <h2>A hybrid Microsoft lab I built and run myself</h2>
        <p>Two Windows Server 2025 domain controllers on an isolated network, synced to Microsoft Entra ID, with devices enrolled in Intune. It's where I practise the work a service desk does every day: joining machines, resetting access, pushing policy and fixing what breaks.</p>
      </div>
      <figure class="lab__figure">
        <img src="/evidence/home-lab.svg" alt="Diagram of the home lab: on-premises Active Directory forest with two domain controllers and client machines, connected through Entra Connect sync to Microsoft Entra ID, Intune and Microsoft 365." width="1500" height="1010" loading="lazy" />
        <figcaption>My lab topology: on-premises AD DS → Entra Connect → Entra ID, Intune and Microsoft 365.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Work: IT track -->
  <section class="section" id="work">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Track 1 · IT support &amp; Microsoft 365</p>
        <h2>Microsoft 365 and identity case studies</h2>
        <p>Each project is written up like a ticket: what I was asked to do, what I built, what broke and how I fixed and verified it.</p>
      </div>
      <div class="grid">
        {itProjects.map((p) => <TicketCard project={p} />)}
      </div>
    </div>
  </section>

  <!-- Work: Security track -->
  <section class="section" id="security">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Track 2 · Security labs</p>
        <h2>Where I'm heading: security operations</h2>
        <p>I want to grow from IT support into cybersecurity. These labs show I can read logs, spot attacks and contain them, which also makes me a more careful support technician today.</p>
      </div>
      <div class="grid">
        {secProjects.map((p) => <TicketCard project={p} />)}
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="section section--tint" id="certifications">
    <div class="wrap">
      <div class="section-head section-head--row">
        <div>
          <p class="eyebrow">Credentials</p>
          <h2>Certifications you can verify</h2>
          <p>Every credential links to its official verification page, so you can confirm it in one click.</p>
        </div>
        <a class="btn btn--ghost" href={profile.linkedin} target="_blank" rel="me noopener"><Icon name="linkedin" /> See them on LinkedIn</a>
      </div>
      <h3 class="group-title">Industry certifications</h3>
      <ul class="certs" role="list">
        {certs.map((c) => (
          <li class="cert">
            <img src={c.badge} alt={`${c.name} badge`} width="88" height="88" loading="lazy" />
            <div class="cert__body">
              <p class="cert__issuer">{c.issuer}</p>
              <h4>{c.name}</h4>
              <p class="cert__dates">Issued {c.issued}{c.expires && <><br />Valid until {c.expires}</>}</p>
              <a class="cert__verify" href={c.verify} target="_blank" rel="noopener">Verify on {c.verifyLabel} <Icon name="external" /><span class="sr-only"> (opens in a new tab)</span></a>
            </div>
          </li>
        ))}
        {inProgress.map((c) => (
          <li class="cert cert--progress">
            <span class="cert__tile cert__tile--progress" aria-hidden="true">MS</span>
            <div class="cert__body">
              <p class="cert__issuer">Microsoft</p>
              <h4>{c.name}: {c.note}</h4>
              <p class="cert__dates"><span class="pill pill--progress">In progress</span></p>
            </div>
          </li>
        ))}
      </ul>
      <h3 class="group-title">Training and courses</h3>
      <ul class="training" role="list">
        {training.map((c) => (
          <li>
            {c.badge ? <img src={c.badge} alt={`${c.name} badge`} width="48" height="48" loading="lazy" /> : <span class="cert__tile" aria-hidden="true">{c.mono ?? initials(c.issuer)}</span>}
            <div>
              <strong>{c.name}</strong>
              <span>{c.issuer}{c.issued && ` · ${c.issued}`}</span>
            </div>
            <a href={c.verify} target="_blank" rel="noopener" aria-label={`Verify ${c.name} (opens in a new tab)`}>Verify <Icon name="external" /></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Skills -->
  <section class="section" id="skills">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Toolbox</p>
        <h2>Skills I use day to day</h2>
      </div>
      <div class="skills__groups">
        {skills.map((g) => (
          <div class="skills__group">
            <h3>{g.group}</h3>
            <ul role="list">{g.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="section" id="experience">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Experience</p>
        <h2>Where I've supported real users</h2>
      </div>
      <div class="exp">
        <div>
          <ol class="timeline" role="list">
            {experience.map((e) => (
              <li>
                <div class="timeline__when mono">{e.when}</div>
                <div>
                  <h3>{e.role}</h3>
                  <p class="timeline__org">{e.org}</p>
                  <p class="timeline__where">{e.where}</p>
                  <ul>{e.points.map((pt) => <li>{pt}</li>)}</ul>
                </div>
              </li>
            ))}
          </ol>
          <p class="after"><a class="link" href="/resume/">Full resume, education and languages</a></p>
        </div>
        <aside class="glance" aria-labelledby="glance-title">
          <h3 id="glance-title">At a glance</h3>
          <dl>
            <div><dt>Support channels</dt><dd>Phone · Email · Chat</dd></div>
            <div><dt>Typical tickets</dt><dd>Password resets, account lockouts, MFA, desktop and app issues, VPN and Wi-Fi</dd></div>
            <div><dt>Platforms</dt><dd>Windows 10/11 · Active Directory · Entra ID · Intune · Microsoft 365</dd></div>
            <div><dt>Languages</dt><dd>{profile.languages}</dd></div>
            <div><dt>Work permit</dt><dd>{profile.workAuth}</dd></div>
          </dl>
          <a class="btn btn--primary" href={profile.resumePdf} download><Icon name="download" /> Download resume</a>
        </aside>
      </div>
    </div>
  </section>

  <!-- GitHub -->
  <section class="section" id="github">
    <div class="wrap gh">
      <div>
        <div class="section-head">
          <p class="eyebrow">Study tools I built</p>
          <h2>Small apps I built to study for my exams</h2>
        </div>
        <ul class="tools" role="list">
          {tools.map((t) => (
            <li><a href={`${profile.github}/${t.repo}`}><strong>{t.name}</strong><span>{t.note}</span></a></li>
          ))}
        </ul>
      </div>
      <div>
        <div class="section-head">
          <p class="eyebrow">Live from GitHub</p>
          <h2>Latest activity</h2>
        </div>
        <ul class="repos" role="list" id="repo-list" data-user={profile.githubUser} data-hidden={[...HIDDEN_REPOS].join(",")}>
          {repos.length === 0 && <li class="repos__empty">See all repositories on <a class="link" href={profile.github}>GitHub</a>.</li>}
          {repos.map((r) => (
            <li>
              <a href={r.html_url}>
                <span class="repos__name">{r.name}</span>
                <span class="repos__meta mono">{r.language ?? "Docs"} · updated {fmt(r.pushed_at)}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="after"><a class="link" href={profile.github}>All repositories on GitHub</a></p>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section section--ink" id="contact">
    <div class="wrap contact">
      <div class="section-head">
        <p class="eyebrow">Contact</p>
        <h2>Hiring for IT support? Let's talk.</h2>
        <p>Send a message here, email me at <a href={`mailto:${profile.email}`}>{profile.email}</a> or connect on <a href={profile.linkedin} target="_blank" rel="me noopener">LinkedIn</a>. I usually reply within one working day.</p>
        <ul class="contact__facts" role="list">
          <li><Icon name="pin" /> {profile.location} · onsite, hybrid or remote</li>
          <li><Icon name="shield" /> {profile.workAuth}</li>
        </ul>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>

<script>
  // ---------- Refresh the GitHub list in the browser so new repos show up without a rebuild ----------
  const list = document.getElementById("repo-list");
  if (list) {
    const hidden = new Set((list.dataset.hidden || "").split(","));
    fetch(`https://api.github.com/users/${list.dataset.user}/repos?per_page=100&sort=pushed`)
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((repos: any[]) => {
        const items = repos.filter((r) => !r.fork && !r.archived && !hidden.has(r.name)).slice(0, 6);
        if (!items.length) return;
        list.replaceChildren(...items.map((r) => {
          const li = document.createElement("li");
          const a = document.createElement("a"); a.href = r.html_url;
          const n = document.createElement("span"); n.className = "repos__name"; n.textContent = r.name;
          const m = document.createElement("span"); m.className = "repos__meta mono";
          m.textContent = `${r.language ?? "Docs"} · updated ${new Date(r.pushed_at).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })}`;
          a.append(n, m); li.append(a); return li;
        }));
      })
      .catch(() => {});
  }
</script>

<style>
  .mono, .repos :global(.mono) { font-family: var(--font-mono); }
  .muted { color: var(--color-text-muted); font-weight: 400; }
  .after { margin-top: var(--space-8); font-weight: 600; font-size: var(--text-sm); }

  /* Hero */
  .hero { padding-block: clamp(var(--space-12), 8vw, var(--space-20)) var(--space-12); background: radial-gradient(1200px 500px at 85% -10%, var(--color-primary-highlight), transparent 70%); }
  .hero__grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(var(--space-8), 5vw, var(--space-16)); align-items: center; }
  .hero__copy { display: grid; gap: var(--space-6); }
  .hero__status { display: inline-flex; align-items: center; gap: var(--space-2); width: fit-content; font-size: var(--text-sm); font-weight: 600; color: var(--color-success); background: var(--color-success-highlight); padding: var(--space-1) var(--space-4); border-radius: var(--radius-full); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 3px color-mix(in oklab, currentColor 25%, transparent); }
  h1 { font-family: var(--font-display); font-weight: 600; font-size: var(--text-2xl); letter-spacing: -0.03em; line-height: 1.06; max-width: 17ch; }
  .hero__lead { color: var(--color-text-muted); font-size: var(--text-base); max-width: 58ch; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; }
  .btn--text { color: var(--color-primary); padding-inline: var(--space-3); }
  .btn--text:hover { color: var(--color-primary-hover); }
  .verified { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); padding-top: var(--space-5); border-top: 1px solid var(--color-divider); }
  .verified__label { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); }
  .verified__label :global(svg) { width: 1.2em; height: 1.2em; color: var(--color-success); }
  .verified__list { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .verified__list a { display: block; border-radius: 50%; transition: transform var(--transition-interactive); }
  .verified__list a:hover { transform: translateY(-2px); }
  .verified__list img { width: 56px; height: 56px; border-radius: var(--radius-md); background: #fff; }
  .snapshot { background: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); overflow: hidden; }
  .snapshot__head { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); padding: var(--space-4) var(--space-5); border-bottom: 1px solid var(--color-divider); font-family: var(--font-display); font-weight: 600; }
  .snapshot dl { display: grid; }
  .snapshot dl > div { display: grid; grid-template-columns: 7rem 1fr; gap: var(--space-3); padding: var(--space-3) var(--space-5); border-bottom: 1px solid var(--color-divider); font-size: var(--text-sm); }
  .snapshot dt { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-faint); padding-top: 3px; }
  .snapshot__foot { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-4) var(--space-5); background: var(--color-surface); font-size: var(--text-sm); font-weight: 600; color: var(--color-primary); text-decoration: none; overflow-wrap: anywhere; }
  .snapshot__foot:hover { color: var(--color-primary-hover); }
  .snapshot__foot :global(svg) { width: 1.1em; height: 1.1em; flex: none; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: clamp(var(--space-10), 6vw, var(--space-16)); background: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
  .stats li { display: grid; gap: var(--space-2); padding: var(--space-6); }
  .stats li + li { border-left: 1px solid var(--color-divider); }
  .stats strong { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; color: var(--color-text); line-height: 1; }
  .stats span { font-size: var(--text-sm); color: var(--color-text-muted); }

  /* Lab */
  .lab__figure { background: #fff; border-radius: var(--radius-lg); padding: clamp(var(--space-3), 2vw, var(--space-6)); }
  .lab__figure figcaption { max-width: none; color: var(--color-text-muted); font-size: var(--text-sm); padding-top: var(--space-3); border-top: 1px solid var(--color-divider); margin-top: var(--space-3); }
  .section--ink a { color: var(--color-ink-accent); }
  .contact__facts { display: grid; gap: var(--space-2); margin-top: var(--space-4); font-size: var(--text-sm); color: var(--color-ink-text); }
  .contact__facts li { display: flex; align-items: center; gap: var(--space-2); }
  .contact__facts :global(svg) { width: 1.1em; height: 1.1em; color: var(--color-ink-accent); flex: none; }

  /* Grids */
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6); }

  /* Certifications */
  .section--tint { background: var(--color-surface-2); }
  .section-head--row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-6); max-width: none; }
  .section-head--row > div { display: grid; gap: var(--space-3); max-width: 62ch; }
  .group-title { font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); margin: 0 0 var(--space-4); }
  .certs { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin-bottom: var(--space-12); }
  .cert { display: grid; grid-template-columns: 88px 1fr; gap: var(--space-5); align-items: center; padding: var(--space-5); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); transition: border-color var(--transition-interactive), box-shadow var(--transition-interactive); }
  .cert:hover { border-color: var(--color-text-faint); box-shadow: var(--shadow-md); }
  .cert img { width: 88px; height: 88px; border-radius: var(--radius-md); background: #fff; }
  .cert__body { display: grid; gap: 2px; min-width: 0; }
  .cert__issuer { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-faint); }
  .cert h4 { font-size: var(--text-base); font-weight: 700; line-height: 1.3; }
  .cert__dates { font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--space-2); }
  .cert__verify, .training a { display: inline-flex; align-items: center; gap: var(--space-1); width: fit-content; font-size: var(--text-sm); font-weight: 600; color: var(--color-primary); text-decoration: none; }
  .cert__verify:hover, .training a:hover { color: var(--color-primary-hover); text-decoration: underline; text-underline-offset: 0.2em; }
  .cert__verify :global(svg), .training a :global(svg) { width: 0.95em; height: 0.95em; }
  .cert--progress { border-style: dashed; }
  .cert__tile { display: grid; place-items: center; width: 48px; height: 48px; border-radius: var(--radius-md); background: var(--color-ink); color: #fff; font-family: var(--font-display); font-weight: 600; font-size: 0.75rem; letter-spacing: 0.04em; }
  .cert__tile--progress { width: 88px; height: 88px; border-radius: 50%; background: var(--color-progress-highlight); color: var(--color-progress); font-size: 1.25rem; }
  .training { display: grid; grid-template-columns: repeat(2, 1fr); border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; background: var(--color-bg); }
  .training li { display: grid; grid-template-columns: 48px 1fr auto; gap: var(--space-4); align-items: center; padding: var(--space-4) var(--space-5); border-top: 1px solid var(--color-divider); }
  .training li:nth-child(-n+2) { border-top: 0; }
  .training li:nth-child(even) { border-left: 1px solid var(--color-divider); }
  .training img { width: 48px; height: 48px; border-radius: var(--radius-md); }
  .training li > div { display: grid; min-width: 0; }
  .training strong { font-size: var(--text-sm); }
  .training span:not(.cert__tile) { font-size: var(--text-sm); color: var(--color-text-muted); }

  /* Skills */
  .skills__groups { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8) var(--space-6); }
  .skills__group h3 { font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); font-weight: 700; margin-bottom: var(--space-3); }
  .skills__group ul { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .skills__group li { font-size: var(--text-sm); padding: var(--space-1) var(--space-3); background: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: var(--radius-md); }

  /* Timeline */
  .timeline { display: grid; }
  .timeline > li { display: grid; grid-template-columns: 12rem 1fr; gap: var(--space-6); padding-block: var(--space-6); border-top: 1px solid var(--color-divider); }
  .timeline > li:last-child { border-bottom: 1px solid var(--color-divider); }
