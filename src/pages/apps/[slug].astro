---
import Base from "../../layouts/Base.astro";
import { apps } from "../../lib/apps";

export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

const { app } = Astro.props;
const src = `/apps/${app.slug}/app.html`;

const appLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: app.name,
  description: app.description,
  applicationCategory: "EducationalApplication",
  operatingSystem: "Any (browser)",
  url: new URL(`/apps/${app.slug}/`, Astro.site ?? "https://ojamadickson.xyz").toString(),
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  author: { "@type": "Person", name: "Dickson Ojama" },
};
---

<Base
  title={`${app.shortName} · ${app.exam} · Dickson Ojama`}
  description={`${app.description} Runs in the browser, free, no signup.`}
  path={`/apps/${app.slug}/`}
  ogImage={`/og/app-${app.slug}.jpg`}
  jsonLd={appLd}
>
  <div class="appbar">
    <div class="wrap appbar__inner">
      <a class="appbar__back" href="/apps/">← All apps</a>
      <h1 class="appbar__title">{app.name}</h1>
      <span class="appbar__exam mono">{app.exam}</span>
      <a class="appbar__new" href={src} target="_blank" rel="noopener">Open full screen ↗</a>
    </div>
  </div>

  <div class="appframe">
    <iframe
      src={src}
      title={`${app.name} — interactive practice app`}
      loading="eager"
      allow="clipboard-write"
    ></iframe>
  </div>

  <noscript>
    <p class="wrap">This app needs JavaScript. The source is on
      <a href={app.repo}>GitHub</a>.</p>
  </noscript>
</Base>

<style>
  .appbar { border-bottom: 1px solid var(--color-border); background: var(--color-surface-2); }
  .appbar__inner { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; padding-block: 10px; font-size: 13.5px; }
  .appbar__back { color: var(--color-text-muted); text-decoration: none; }
  .appbar__back:hover { color: var(--color-primary); }
  .appbar__title { font-family: var(--font-body); font-size: 13.5px; font-weight: 600; margin: 0; }
  .appbar__exam { font-size: 11px; letter-spacing: .06em; color: var(--color-primary); border: 1px solid var(--color-border); border-radius: 999px; padding: 2px 8px; }
  .appbar__new { margin-left: auto; color: var(--color-primary); text-decoration: none; }

  .appframe { width: 100%; height: calc(100dvh - 68px - 49px); min-height: 520px; background: #0b1020; }
  .appframe iframe { display: block; width: 100%; height: 100%; border: 0; }
</style>
