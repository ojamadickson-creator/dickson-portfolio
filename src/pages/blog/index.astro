---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { profile } from "../../lib/profile";
import { readingTime } from "../../lib/reading";

const all = await getCollection("blog", ({ data }) => !data.draft || import.meta.env.DEV);
const posts = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: `Blog — ${profile.name}`,
  url: new URL("/blog/", Astro.site ?? "https://ojamadickson.xyz").toString(),
  blogPost: posts.slice(0, 10).map((p) => ({
    "@type": "BlogPosting",
    headline: p.data.title,
    datePublished: p.data.date.toISOString(),
    url: new URL(`/blog/${p.id}/`, Astro.site ?? "https://ojamadickson.xyz").toString(),
  })),
};
---

<Base
    ogImage="/og/blog.jpg"
  title={`Blog · Intune, Entra ID and Microsoft 365 · ${profile.name}`}
  description="Practical guides and field notes from a home lab and a service desk: Intune, Entra ID, Microsoft 365, and the tickets in between — with screenshots and what the results actually looked like."
  path="/blog/"
  jsonLd={itemListLd}
>
  <section class="blog-hero">
    <div class="wrap blog-hero__inner">
      <p class="eyebrow">Blog</p>
      <h1>Notes from the desk.</h1>
      <p class="blog-hero__lede">
        Guides from a home lab and notes from the tickets — Intune, Entra ID and the service desk, with the
        settings, the screenshots, and what the results actually looked like. Written from the work, not
        from a slide deck.
      </p>
    </div>
  </section>

  <section class="blog-welcome" aria-labelledby="welcome-heading">
    <div class="wrap">
      <div class="welcome">
        <p class="eyebrow" id="welcome-heading">Welcome</p>
        <div class="welcome__body">
          <p>Hello, and thank you for stopping by.</p>
          <p>
            I am Dickson Ojama, an IT support technician in Lisbon. I work the service desk — Windows and
            Mac endpoints, Microsoft 365, Entra ID and Intune — the tickets where someone cannot sign in,
            cannot open their email, or cannot get back to work. Seven years of customer support sit behind
            that, three of them technical: first remote for US companies, now on a desk in Lisbon, on the
            south bank of the Tagus in Almada. My Portuguese is A2, and less shy every month.
          </p>
          <p class="welcome__pull">What I like is the moment a ticket turns from panic into a plan.</p>
          <p>
            I keep a home lab — two domain controllers, Entra Connect, Intune and a lot of PowerShell —
            because I would rather break my own tenant than a client's. The walkthroughs here come from it.
          </p>
          <p>
            Where I am going: security operations. Security+, Network+ and A+ are done, <span class="nowrap">MD-102</span> is next, and I want to read a log as comfortably as I read a ticket.
          </p>
          <p>
            If you are hiring, curious, or stuck on something, <a href="/#contact">write to me</a>. I answer.
          </p>
          <p class="welcome__sign mono">— Dickson</p>
        </div>
      </div>
    </div>
  </section>

  <section class="blog-list">
    <div class="wrap">
      {posts.length === 0 ? (
        <p class="blog-empty">First post is in progress — check back soon.</p>
      ) : (
        <ul class="posts" role="list">
          {posts.map((post) => (
            <li class="post-card">
              <a class="post-card__link" href={`/blog/${post.id}/`}>
                <p class="post-card__meta mono">
                  <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
                  <span aria-hidden="true">·</span>
                  <span>{readingTime(post.body)} min read</span>
                </p>
                <h2 class="post-card__title">{post.data.title}</h2>
                <p class="post-card__desc">{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <p class="post-card__tags mono">{post.data.tags.join(" · ")}</p>
                )}
                <span class="post-card__cta">Read the post <span aria-hidden="true">→</span></span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>

<style>
  .blog-hero {
    padding: clamp(40px, 6vw, 84px) 0 clamp(20px, 3vw, 32px);
    border-bottom: 1px solid var(--color-border);
  }
  .blog-hero :global(.wrap) { max-width: 820px; }
  .blog-hero__inner { display: grid; gap: 12px; }
  .blog-hero h1 { font-family: var(--font-display); font-size: clamp(32px, 5vw, 56px); line-height: 1.04; letter-spacing: -0.02em; }
  .blog-hero__lede { color: var(--color-text-muted); font-size: 17px; max-width: 58ch; }

  .blog-welcome { padding: clamp(28px, 4.5vw, 52px) 0 clamp(4px, 1.5vw, 12px); }
  .blog-welcome :global(.wrap) { max-width: 820px; }
  .welcome { display: grid; gap: 14px; }
  .welcome__body { display: grid; gap: 15px; max-width: 58ch; }
  .welcome__body p { font-size: 17px; line-height: 1.75; color: var(--color-text-muted); }
  .welcome__body p:first-child { color: var(--color-text); }
  .welcome__body a { color: var(--color-primary); text-decoration: underline; text-underline-offset: 2px; }
  .welcome__body .nowrap { white-space: nowrap; }
  .welcome__body p.welcome__pull {
    font-family: var(--font-display);
    font-size: clamp(19px, 2.2vw, 23px);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--color-text);
    padding-left: 16px;
    border-left: 3px solid var(--color-primary);
  }
  .welcome__sign { font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-text-faint); }

  .blog-list { padding: clamp(32px, 5vw, 56px) 0 clamp(56px, 8vw, 96px); }
  .blog-list :global(.wrap) { max-width: 820px; }
  .posts { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .post-card { max-width: none; }
  .post-card { border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface-2); transition: border-color .16s ease, transform .16s ease; }
  .post-card:hover { border-color: var(--color-primary); transform: translateY(-2px); }
  .post-card__link { display: grid; gap: 8px; padding: clamp(18px, 2.4vw, 26px); text-decoration: none; color: inherit; }
  .post-card__meta { display: flex; gap: 8px; font-size: 11.5px; color: var(--color-text-muted); letter-spacing: .04em; text-transform: uppercase; }
  .post-card__title { font-family: var(--font-display); font-size: clamp(20px, 2.3vw, 26px); line-height: 1.2; letter-spacing: -0.01em; }
  .post-card__desc { color: var(--color-text-muted); font-size: 15px; max-width: 76ch; }
  .post-card__tags { font-size: 11.5px; color: var(--color-text-muted); letter-spacing: .04em; }
  .post-card__cta { font-weight: 600; font-size: 14px; color: var(--color-primary); }
  .blog-empty { color: var(--color-text-muted); }
</style>
