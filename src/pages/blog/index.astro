---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { profile } from "../../lib/profile";

const all = await getCollection("blog", ({ data }) => !data.draft || import.meta.env.DEV);
const posts = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const readingTime = (body?: string) => Math.max(1, Math.round((body ?? "").split(/\s+/).length / 200));
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: `Blog — ${profile.name}`,
  url: new URL("/blog/", Astro.site ?? "https://ojamadickson.xyz").toString(),
  blogPost: posts.slice(0, 10).map((p) => ({
    "@type": "BlogPosting",
    headline: p.data.title,
    datePublished: p.data.date.toISOString(),
    url: new URL(`/blog/${p.id}/`, Astro.site ?? "https://ojamadickson.xyz").toString(),
  })),
};
---

<Base
  title={`Blog · Notes on IT support and Microsoft 365 · ${profile.name}`}
  description="Practical notes from the service desk: ticket triage, documentation, Windows and Mac support, Microsoft 365, Entra ID and Intune — written from day-to-day work, not theory."
  path="/blog/"
  jsonLd={itemListLd}
>
  <section class="blog-hero">
    <div class="wrap blog-hero__inner">
      <p class="eyebrow">Blog</p>
      <h1>Notes from the desk.</h1>
      <p class="blog-hero__lede">
        Short, practical write-ups from real support work — what broke, what fixed it, and what I would do
        differently next time. No theory that survives only in a slide deck.
      </p>
    </div>
  </section>

  <section class="blog-list">
    <div class="wrap">
      {posts.length === 0 ? (
        <p class="blog-empty">First post is in progress — check back soon.</p>
      ) : (
        <ul class="posts" role="list">
          {posts.map((post) => (
            <li class="post-card">
              <a class="post-card__link" href={`/blog/${post.id}/`}>
                <p class="post-card__meta mono">
                  <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
                  <span aria-hidden="true">·</span>
                  <span>{readingTime(post.body)} min read</span>
                </p>
                <h2 class="post-card__title">{post.data.title}</h2>
                <p class="post-card__desc">{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <p class="post-card__tags mono">{post.data.tags.join(" · ")}</p>
                )}
                <span class="post-card__cta">Read the post <span aria-hidden="true">→</span></span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>

<style>
  .blog-hero {
    padding: clamp(40px, 6vw, 84px) 0 clamp(20px, 3vw, 32px);
    border-bottom: 1px solid var(--color-border);
  }
  .blog-hero :global(.wrap) { max-width: 820px; }
  .blog-hero__inner { display: grid; gap: 12px; }
  .blog-hero h1 { font-family: var(--font-display); font-size: clamp(32px, 5vw, 56px); line-height: 1.04; letter-spacing: -0.02em; }
  .blog-hero__lede { color: var(--color-text-muted); font-size: 17px; max-width: 58ch; }

  .blog-list { padding: clamp(32px, 5vw, 56px) 0 clamp(56px, 8vw, 96px); }
  .blog-list :global(.wrap) { max-width: 820px; }
  .posts { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .post-card { max-width: none; }
  .post-card { border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface-2); transition: border-color .16s ease, transform .16s ease; }
  .post-card:hover { border-color: var(--color-primary); transform: translateY(-2px); }
  .post-card__link { display: grid; gap: 8px; padding: clamp(18px, 2.4vw, 26px); text-decoration: none; color: inherit; }
  .post-card__meta { display: flex; gap: 8px; font-size: 11.5px; color: var(--color-text-muted); letter-spacing: .04em; text-transform: uppercase; }
  .post-card__title { font-family: var(--font-display); font-size: clamp(20px, 2.3vw, 26px); line-height: 1.2; letter-spacing: -0.01em; }
  .post-card__desc { color: var(--color-text-muted); font-size: 15px; max-width: 76ch; }
  .post-card__tags { font-size: 11.5px; color: var(--color-text-muted); letter-spacing: .04em; }
  .post-card__cta { font-weight: 600; font-size: 14px; color: var(--color-primary); }
  .blog-empty { color: var(--color-text-muted); }
</style>
