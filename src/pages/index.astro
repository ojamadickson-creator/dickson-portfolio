---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import { credentials } from "../lib/profile";

const certs = credentials.filter((c) => c.kind === "cert");
---

<Base
    ogImage="/og/home.jpg"
  title="Level 2 IT support: Windows, Mac, Microsoft 365 · Dickson Ojama"
  description="Level 2 IT support for Windows, Mac, Microsoft 365, Entra ID and Intune. Three years of documented fixes, CompTIA certified, Lisbon / Almada."
  dark
  intro
  preload="/home/hero-shield.webp"
>
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <span class="pill"><i class="dot"></i>Open to L2 roles · Lisbon</span>
        <h1>Level 2 support for <em>Windows, Mac, Microsoft 365</em> and identity.</h1>
        <p class="lede">Three years of documented fixes across Windows and Mac endpoints, Microsoft 365, Entra ID and Intune — not just closed tickets.</p>
        <div class="actions">
          <a class="btn btn--primary" href="#work">See case studies →</a>
          <a class="btn btn--ghost" href="#contact">Contact</a>
        </div>
        <div class="stats">
          <div><b>99%</b><span>first-contact resolution</span></div>
          <div><b>85%+</b><span>at Teleperformance</span></div>
          <div><b>3 yrs</b><span>Technical Support</span></div>
          <div><b>7+ yrs</b><span>customer support</span></div>
        </div>
      </div>

      <div class="art">
        <div class="art__frame">
          <img src="/home/hero-shield.webp" alt="Glowing security shield in a dark server hall" width="1100" height="1100" fetchpriority="high" />
        </div>
        <div class="chip chip--sec"><img src="/badges/secplus.webp" alt="CompTIA Security+ badge" width="18" height="18" />Security+ ce</div>
        <div class="chip chip--md"><i></i>MD-102 in progress</div>
        <div class="art__card"><img src="/home/lock.webp" alt="Glowing padlock illustration" width="800" height="800" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <section id="what" class="band">
    <div class="wrap">
      <span class="eyebrow">What I do</span>
      <h2>Four areas, end to end.</h2>
      <div class="cards">
        <article class="cap">
          <img class="tile" src="/icons/service-desk.webp" alt="Service desk and remote support" width="52" height="52" loading="lazy" decoding="async" />
          <h3>Service desk</h3><p>L1 · L2 · SLA · escalation</p>
        </article>
        <article class="cap">
          <img class="tile" src="/icons/win-mac.webp" alt="Windows and Mac endpoint support" width="52" height="52" loading="lazy" decoding="async" />
          <h3>Windows &amp; Mac</h3><p>Win 11 · macOS · devices</p>
        </article>
        <article class="cap">
          <img class="tile" src="/icons/m365-identity.webp" alt="Microsoft 365, Entra ID and Intune" width="52" height="52" loading="lazy" decoding="async" />
          <h3>Microsoft 365 &amp; identity</h3><p>Entra ID · Intune · SharePoint</p>
        </article>
        <article class="cap">
          <img class="tile" src="/icons/network.webp" alt="Networking, DNS and VPN" width="52" height="52" loading="lazy" decoding="async" />
          <h3>Network</h3><p>TCP/IP · DNS · VPN · Wi-Fi</p>
        </article>
      </div>
    </div>
  </section>

  <section id="certs" class="certs-band">
    <div class="wrap certs-card">
      <div class="certs-copy">
        <span class="eyebrow">Verified credentials</span>
        <h2>Five CompTIA certifications, all checkable.</h2>
        <p>Security+ · Network+ · A+ · CSIS · CIOS — each badge links to its official Credly record.</p>
      </div>
      <ul class="certs-badges" role="list">
        {certs.map((c) => (
          <li>
            <a href={c.verify} target="_blank" rel="noopener" title={`Verify ${c.name} on ${c.verifyLabel}`}>
              <img src={c.badge} alt={`${c.name} badge`} width="84" height="84" loading="lazy" />
              <span>{c.short}</span>
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn--ghost certs-link" href="/about/#certifications">Verify on Credly →</a>
    </div>
  </section>

  <section id="work" class="band">
    <div class="wrap">
      <span class="eyebrow">Selected work</span>
      <h2>Case studies, written like tickets.</h2>
      <div class="work">
        <a class="proj" href="/projects/active-directory/">
          <div class="proj__img"><img src="/evidence/entra.webp" alt="Entra ID lab evidence" loading="lazy" /></div>
          <div class="proj__body"><span class="mono">LAB-01</span><h3>Active Directory forest &amp; hardening</h3></div>
        </a>
        <a class="proj" href="/projects/intune-hybrid/">
          <div class="proj__img"><img src="/evidence/intune.webp" alt="Intune policy evidence" loading="lazy" /></div>
          <div class="proj__body"><span class="mono">LAB-03</span><h3>Hybrid identity &amp; Intune</h3></div>
        </a>
        <a class="proj" href="/projects/smb-brute-force/">
          <div class="proj__img"><img src="/evidence/smb.webp" alt="Splunk detection evidence" loading="lazy" /></div>
          <div class="proj__body"><span class="mono">SEC-02</span><h3>Brute-force detection in Splunk</h3></div>
        </a>
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="wrap contact-grid">
      <div class="contact-copy">
        <span class="eyebrow">Contact</span>
        <h2>Hiring for L2 support?</h2>
        <p>Fill this in and it lands in my inbox — or email me directly at
          <a href="mailto:dickson@ojamadickson.xyz">dickson@ojamadickson.xyz</a>.</p>
        <ul class="contact-facts" role="list">
          <li>Lisbon / Almada · onsite or hybrid</li>
          <li>Portuguese work permit (Título de Residência)</li>
          <li>Usually replies within one working day</li>
        </ul>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>

<style>
  .wrap{width:min(100% - 40px,1720px);margin-inline:auto}
  main{padding-bottom:72px}

  .hero{padding:52px 0 8px}
  .hero__grid{display:grid;grid-template-columns:1.02fr .98fr;gap:46px;align-items:center}
  .pill{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,.16);border-radius:999px;padding:6px 12px 6px 9px;font-size:12px;color:#9aabc2;background:rgba(255,255,255,.03)}
  .dot{width:7px;height:7px;border-radius:50%;background:#2dd4bf;box-shadow:0 0 0 3px rgba(45,212,191,.15),0 0 14px rgba(45,212,191,.7)}
  h1{font-family:var(--font-display);font-weight:600;font-size:clamp(34px,4.2vw,54px);line-height:1.04;letter-spacing:-.025em;margin:16px 0 0;color:#f4f8ff}
  h1 em{font-style:normal;background:linear-gradient(100deg,#6ea8ff,#a78bfa 55%,#2dd4bf);-webkit-background-clip:text;background-clip:text;color:transparent}
  .lede{margin-top:14px;font-size:16.5px;color:#9aabc2;max-width:34ch}
  .actions{display:flex;gap:12px;margin-top:24px;flex-wrap:wrap}
  .btn{display:inline-flex;align-items:center;gap:9px;border-radius:999px;padding:12px 20px;font-size:14.5px;font-weight:500;border:1px solid transparent}
  .btn--primary{color:#fff;background:linear-gradient(135deg,#3b7bff,#8b5cf6);box-shadow:0 16px 34px -18px rgba(59,123,255,.95)}
  .btn--ghost{border-color:rgba(255,255,255,.16);background:rgba(255,255,255,.04);color:#eef3fa}
  .btn--light{background:#fff;color:#101828}
  .stats{display:flex;gap:30px;margin-top:30px;padding-top:20px;border-top:1px solid rgba(255,255,255,.09)}
  .stats b{font-family:var(--font-display);font-weight:600;font-size:24px;display:block;color:#fff}
  .stats span{font-size:11.5px;color:#6f8199;display:block;margin-top:2px}

  .art{position:relative;max-width:740px;justify-self:end;width:100%}
  .art__frame{position:relative;border-radius:24px;overflow:hidden;border:1px solid rgba(255,255,255,.12);
              box-shadow:0 50px 90px -40px rgba(59,123,255,.55),inset 0 1px 0 rgba(255,255,255,.08)}
  .art__frame img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block}
  .art__card{position:absolute;left:-7%;bottom:-9%;width:46%;border-radius:16px;overflow:hidden;
             border:1px solid rgba(255,255,255,.18);box-shadow:0 34px 70px -26px rgba(0,0,0,.95)}
  .art__card img{width:100%;height:auto;display:block}
  .chip{position:absolute;display:flex;align-items:center;gap:8px;padding:8px 11px;border-radius:11px;font-size:11.5px;
        background:rgba(10,17,32,.86);border:1px solid rgba(255,255,255,.16);backdrop-filter:blur(8px)}
  .chip img{width:18px;height:18px;object-fit:contain}
  .chip--sec{right:-3%;top:6%}
  .chip--md{left:-6%;top:44%}
  .chip--md i{width:7px;height:7px;border-radius:50%;background:#f59e0b;display:block;box-shadow:0 0 10px rgba(245,158,11,.8)}

  .band{padding:48px 0}
  section{padding:40px 0}
  .eyebrow{font-family:var(--font-mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:#7f93ad}
  h2{font-family:var(--font-display);font-weight:600;font-size:clamp(21px,2.2vw,27px);letter-spacing:-.01em;margin-top:8px;color:#f2f7ff}
  .cards{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:20px}
  .cap{padding:18px 16px;border-radius:16px;border:1px solid rgba(255,255,255,.09);
       background:linear-gradient(180deg,rgba(255,255,255,.045),rgba(255,255,255,.015));transition:transform .18s ease,border-color .18s ease}
  .cap:hover{transform:translateY(-3px);border-color:rgba(255,255,255,.22)}
  .tile{width:52px;height:52px;display:block;filter:drop-shadow(0 8px 16px rgba(0,0,0,.45))}
  .t-blue{background:rgba(59,123,255,.16)} .t-blue svg{stroke:#8bb4ff}
  .t-teal{background:rgba(45,212,191,.14)} .t-teal svg{stroke:#5eead4}
  .t-violet{background:rgba(139,92,246,.16)} .t-violet svg{stroke:#c4b5fd}
  .t-amber{background:rgba(245,158,11,.14)} .t-amber svg{stroke:#fcd34d}
  .cap h3{font-family:var(--font-display);font-size:16px;font-weight:600;margin-top:16px}
  .cap p{font-family:var(--font-mono);font-size:12.5px;line-height:1.5;letter-spacing:.02em;color:#a3b3c8;margin-top:6px}

  .creds{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:16px 22px;border-radius:18px;
         border:1px solid rgba(255,255,255,.09);background:linear-gradient(90deg,rgba(59,123,255,.10),rgba(139,92,246,.08))}
  .creds b{font-family:var(--font-display);font-size:14px;font-weight:600;display:block}
  .creds span{font-size:12px;color:#9aabc2}
  .creds img{width:42px;height:42px;object-fit:contain}
  .creds__row{display:flex;gap:8px}
  .link{font-size:12.5px;color:#8bb4ff;white-space:nowrap}

  .work{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:20px}
  .proj{border-radius:16px;overflow:hidden;border:1px solid rgba(255,255,255,.09);background:#0d1524;transition:transform .18s ease}
  .proj:hover{transform:translateY(-3px)}
  .proj__img{height:150px;overflow:hidden;position:relative;background:#0a1220}
  .proj__img::before{content:"";position:absolute;inset:0;background:linear-gradient(145deg,rgba(59,123,255,.22),rgba(139,92,246,.18));mix-blend-mode:color;z-index:1}
  .proj__img::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,12,22,0) 45%,rgba(7,12,22,.85));z-index:2}
  .proj__img img{width:100%;height:100%;object-fit:cover;transition:transform .4s ease;
                 filter:invert(1) hue-rotate(185deg) saturate(.6) brightness(.92) contrast(1.08);opacity:.95}
  .proj:hover .proj__img img{transform:scale(1.04)}
  .proj__body{padding:14px 15px 16px}
  .mono{font-family:var(--font-mono);font-size:9.5px;letter-spacing:.12em;color:#7f93ad}
  .proj__body h3{font-family:var(--font-display);font-size:14.5px;font-weight:600;margin-top:6px;line-height:1.3}

  .close{position:relative;overflow:hidden;border-radius:22px;border:1px solid rgba(255,255,255,.12);
         background:linear-gradient(115deg,#12224a 0%,#221a4d 55%,#0f2b3f 100%);padding:34px 36px;
         display:flex;align-items:center;justify-content:space-between;gap:24px}
  .close::after{content:"";position:absolute;inset:0;background:url(/home/mesh.webp) center/cover no-repeat;opacity:.30;mix-blend-mode:screen}
  .close > *{position:relative;z-index:1}
  .close h2{color:#fff;margin:0;font-size:clamp(20px,2vw,26px)}
  .close p{color:#b7c6da;font-size:13.5px;margin-top:6px}

  /* floating hero art */
  .art__frame { animation: float-a 9s ease-in-out infinite; }
  .art__card { animation: float-b 11s ease-in-out -3s infinite; }
  .chip--sec { animation: float-c 7s ease-in-out -1s infinite; }
  .chip--md { animation: float-c 8s ease-in-out -4s infinite; }
  @keyframes float-a {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(0.001deg); }
    50% { transform: translate3d(0, -12px, 0) rotate(0.001deg); }
  }
  @keyframes float-b {
    0%, 100% { transform: translate3d(0, 0, 0); }
    50% { transform: translate3d(0, 14px, 0); }
  }
  @keyframes float-c {
    0%, 100% { transform: translate3d(0, 0, 0); }
    50% { transform: translate3d(0, -7px, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .art__frame, .art__card, .chip--sec, .chip--md { animation: none; }
  }

  @media (max-width: 980px){
    .hero__grid{grid-template-columns:1fr;gap:30px}
    .art{order:-1}
    .cards{grid-template-columns:repeat(2,1fr)}
    .work{grid-template-columns:1fr}
    .creds{flex-wrap:wrap}
    .close{flex-direction:column;align-items:flex-start}
    .lede{max-width:none}
    .chip--sec{right:8px;top:8px}
    .chip--md{left:8px;top:auto;bottom:8px}
    .art__card{width:54%;left:2%;bottom:-8%}
  }
  /* Contact + form */
  .contact-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(24px, 4vw, 56px); align-items: start; }
  .contact-copy h2 { margin-top: 8px; }
  .contact-copy p { color: #9aabc2; font-size: 15px; margin-top: 12px; max-width: 40ch; }
  .contact-copy a { color: #8bb4ff; }
  .contact-facts { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 9px; font-size: 13px; color: #8fa2ba; }
  .contact-facts li { position: relative; padding-left: 16px; }
  .contact-facts li::before { content: ""; position: absolute; left: 0; top: 7px; width: 6px; height: 6px; border-radius: 50%; background: #2dd4bf; }
  @media (max-width: 980px) {
    .contact-grid { grid-template-columns: 1fr; }
  }

  /* Credentials band */
  .certs-band { padding: 30px 0 46px; }
  .certs-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: clamp(20px, 3vw, 40px);
    padding: clamp(22px, 2.4vw, 34px);
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background:
      linear-gradient(120deg, rgba(59, 123, 255, 0.16), rgba(139, 92, 246, 0.12) 55%, rgba(15, 156, 150, 0.12));
    box-shadow: 0 34px 70px -46px rgba(59, 123, 255, 0.75), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }
  .certs-copy h2 { font-size: clamp(22px, 2.3vw, 31px); margin-top: 6px; }
  .certs-copy p { color: #a9b8cc; font-size: 14px; margin-top: 8px; max-width: 44ch; }
  .certs-badges { display: flex; align-items: flex-start; gap: clamp(12px, 1.6vw, 22px); list-style: none; margin: 0; padding: 0; }
  .certs-badges a { display: grid; justify-items: center; gap: 8px; text-decoration: none; }
  .certs-badges img { width: clamp(60px, 5.6vw, 84px); height: auto; transition: transform 0.18s ease; filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.45)); }
  .certs-badges a:hover img, .certs-badges a:focus-visible img { transform: translateY(-4px) scale(1.05); }
  .certs-badges span { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em; color: #cbd8ea; }
  .certs-link { justify-self: end; white-space: nowrap; }
  @media (max-width: 1100px) {
    .certs-card { grid-template-columns: 1fr; justify-items: start; }
    .certs-badges { flex-wrap: wrap; }
    .certs-link { justify-self: start; }
  }
</style>

