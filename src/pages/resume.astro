---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { profile, experience, credentials, inProgress, skills } from "../lib/profile";
---
<Base title="Resume · Dickson Ojama" description="Resume of Dickson Ojama, IT Support Technician (L1/L2) in Lisbon: experience, certifications, skills and education." path="/resume/">
  <div class="wrap--narrow resume">
    <header>
      <p class="eyebrow">Resume</p>
      <h1>{profile.name}</h1>
      <p class="lead">{profile.role} · {profile.focus} · {profile.location}</p>
      <div class="cta">
        <a class="btn btn--primary" href={profile.resumePdf} download><Icon name="download" /> Download PDF</a>
        <a class="btn btn--ghost" href={`mailto:${profile.email}`}><Icon name="mail" /> {profile.email}</a>
        <a class="btn btn--ghost" href={profile.linkedin} target="_blank" rel="me noopener"><Icon name="linkedin" /> LinkedIn</a>
      </div>
    </header>

    <section><h2>Summary</h2><p>{profile.summary}</p></section>

    <section>
      <h2>Experience</h2>
      {experience.map((e) => (
        <div class="item">
          <div class="item__head"><h3>{e.role}, {e.org}</h3><span class="mono">{e.when}</span></div>
          <p class="muted">{e.where}</p>
          <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
        </div>
      ))}
    </section>

    <section>
      <h2>Certifications</h2>
      <ul class="creds" role="list">
        {credentials.map((c) => (
          <li>
            <div><strong>{c.name}</strong><span class="muted">{c.issuer}{c.issued && ` · ${c.issued}`}{c.expires && ` · valid until ${c.expires}`}</span></div>
            <a class="verify" href={c.verify} target="_blank" rel="noopener">Verify <Icon name="external" /><span class="sr-only"> {c.name} (opens in a new tab)</span></a>
          </li>
        ))}
        {inProgress.map((c) => <li><div><strong>{c.name}: {c.note}</strong><span class="muted">In progress</span></div></li>)}
      </ul>
    </section>

    <section>
      <h2>Skills</h2>
      <dl class="skills">{skills.map((g) => <div><dt>{g.group}</dt><dd>{g.items.join(", ")}</dd></div>)}</dl>
    </section>

    <section>
      <h2>Education</h2>
      <div class="item"><div class="item__head"><h3>General Medicine, years 1–3 (incomplete)</h3><span class="mono">2013 – 2017</span></div><p class="muted">Danylo Halytsky Lviv National Medical University, Ukraine</p></div>
      <div class="item"><div class="item__head"><h3>Diploma in Computer Studies &amp; Applications</h3><span class="mono">2013</span></div><p class="muted">Destiny Computer Institute, Makurdi, Nigeria</p></div>
    </section>

    <section>
      <h2>Languages &amp; work authorisation</h2>
      <p>{profile.languages}. {profile.workAuth}.</p>
    </section>
  </div>
</Base>
<style>
  .resume { padding-block: clamp(var(--space-10), 6vw, var(--space-20)); display: grid; gap: var(--space-12); }
  header { display: grid; gap: var(--space-4); }
  h1 { font-family: var(--font-display); font-weight: 600; font-size: var(--text-2xl); letter-spacing: -0.02em; }
  .lead { color: var(--color-text-muted); }
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  h2 { font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-primary); padding-bottom: var(--space-3); border-bottom: 1px solid var(--color-border); margin-bottom: var(--space-5); }
  .item + .item { margin-top: var(--space-6); }
  .item__head { display: flex; justify-content: space-between; gap: var(--space-4); align-items: baseline; flex-wrap: wrap; }
  h3 { font-family: var(--font-display); font-weight: 700; font-size: var(--text-base); }
  .mono { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-muted); }
  .muted { color: var(--color-text-muted); font-size: var(--text-sm); margin-bottom: var(--space-2); }
  ul { padding-left: 1.1em; display: grid; gap: var(--space-2); font-size: var(--text-sm); }
  .skills { display: grid; gap: var(--space-3); font-size: var(--text-sm); }
  .skills div { display: grid; grid-template-columns: 10rem 1fr; gap: var(--space-3); }
  .skills dt { font-weight: 700; }
  .creds { padding-left: 0; gap: 0; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface-2); overflow: hidden; }
  .creds li { max-width: none; display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); padding: var(--space-3) var(--space-4); }
  .creds li + li { border-top: 1px solid var(--color-divider); }
  .creds li > div { display: grid; }
  .creds .muted { margin: 0; }
  .verify { display: inline-flex; align-items: center; gap: var(--space-1); color: var(--color-primary); font-weight: 600; text-decoration: none; white-space: nowrap; }
  .verify:hover { text-decoration: underline; }
  .verify :global(svg) { width: 0.95em; height: 0.95em; }
  @media (max-width: 560px) { .skills div { grid-template-columns: 1fr; gap: 0; } }

  /* Ctrl+P: one clean A4 document, black on white, no site chrome. */
  @media print {
    @page { size: A4; margin: 14mm 16mm; }
    :global(.site-header), :global(.site-footer), :global(.palette), :global(a.sr-only), .cta { display: none !important; }
    :global(html), :global(body) { background: #fff !important; color: #000 !important; font-size: 10.5pt; }
    .resume { width: auto; padding: 0; gap: 14pt; }
    h1 { font-size: 22pt; }
    h2 { color: #000; border-bottom-color: #000; margin-bottom: 6pt; padding-bottom: 3pt; }
    h3, p, li, dt, dd, strong, .lead, .muted, .mono { color: #000 !important; }
    .item, .creds li, .skills div { break-inside: avoid; }
    .creds { border-color: #000; background: none; }
    .creds li + li { border-top-color: #999; }
    .verify { color: #000; }
    .verify :global(svg) { display: none; }
    section { break-inside: auto; }
    h2 { break-after: avoid; }
  }
</style>
