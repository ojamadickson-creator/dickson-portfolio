---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { profile, experience, certifications, skills } from "../lib/profile";
---
<Base title="Resume · Dickson Ojama" description="Resume of Dickson Ojama, IT Support Technician (L1/L2) in Lisbon: experience, certifications, skills and education." path="/resume/">
  <div class="wrap--narrow resume">
    <header>
      <p class="eyebrow">Resume</p>
      <h1>{profile.name}</h1>
      <p class="lead">{profile.role} · {profile.focus} · {profile.location}</p>
      <div class="cta">
        <a class="btn btn--primary" href={profile.resumePdf} download><Icon name="download" /> Download PDF</a>
        <a class="btn btn--ghost" href={`mailto:${profile.email}`}><Icon name="mail" /> {profile.email}</a>
      </div>
    </header>

    <section><h2>Summary</h2><p>{profile.summary}</p></section>

    <section>
      <h2>Experience</h2>
      {experience.map((e) => (
        <div class="item">
          <div class="item__head"><h3>{e.role}, {e.org}</h3><span class="mono">{e.when}</span></div>
          <p class="muted">{e.where}</p>
          <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
        </div>
      ))}
    </section>

    <section>
      <h2>Certifications</h2>
      <ul>{certifications.map((c) => <li><strong>{c.name}</strong>: {c.status === "done" ? c.note : "in progress"}</li>)}</ul>
    </section>

    <section>
      <h2>Skills</h2>
      <dl class="skills">{skills.map((g) => <div><dt>{g.group}</dt><dd>{g.items.join(", ")}</dd></div>)}</dl>
    </section>

    <section>
      <h2>Education</h2>
      <div class="item"><div class="item__head"><h3>General Medicine, years 1–3 (incomplete)</h3><span class="mono">2013 – 2017</span></div><p class="muted">Danylo Halytsky Lviv National Medical University, Ukraine</p></div>
      <div class="item"><div class="item__head"><h3>Diploma in Computer Studies &amp; Applications</h3><span class="mono">2013</span></div><p class="muted">Destiny Computer Institute, Makurdi, Nigeria</p></div>
    </section>

    <section>
      <h2>Languages &amp; work authorisation</h2>
      <p>{profile.languages}. {profile.workAuth}.</p>
    </section>
  </div>
</Base>
<style>
  .resume { padding-block: clamp(var(--space-10), 6vw, var(--space-20)); display: grid; gap: var(--space-12); }
  header { display: grid; gap: var(--space-4); }
  h1 { font-family: var(--font-display); font-weight: 800; font-size: var(--text-2xl); letter-spacing: -0.02em; }
  .lead { color: var(--color-text-muted); }
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  h2 { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted); padding-bottom: var(--space-3); border-bottom: 1px solid var(--color-border); margin-bottom: var(--space-5); }
  .item + .item { margin-top: var(--space-6); }
  .item__head { display: flex; justify-content: space-between; gap: var(--space-4); align-items: baseline; flex-wrap: wrap; }
  h3 { font-family: var(--font-display); font-weight: 700; font-size: var(--text-base); }
  .mono { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-muted); }
  .muted { color: var(--color-text-muted); font-size: var(--text-sm); margin-bottom: var(--space-2); }
  ul { padding-left: 1.1em; display: grid; gap: var(--space-2); font-size: var(--text-sm); }
  .skills { display: grid; gap: var(--space-3); font-size: var(--text-sm); }
  .skills div { display: grid; grid-template-columns: 10rem 1fr; gap: var(--space-3); }
  .skills dt { font-weight: 700; }
  @media (max-width: 560px) { .skills div { grid-template-columns: 1fr; gap: 0; } }
</style>
